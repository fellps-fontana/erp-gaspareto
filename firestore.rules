rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function callerUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userCompanyId() {
      return callerUser().companyId;
    }

    function userRole() {
      return callerUser().role;
    }

    function isSuperAdminUser() {
      return callerUser().get('isSuperAdmin', false) == true;
    }

    function isOperationalCollection(collection) {
      return collection in ['products', 'sales', 'comandas', 'orders', 'bills', 'customers', 'purchases', 'purchaseProducts', 'vendedores'];
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdminUser());
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.companyId == uid
        && request.resource.data.role == 'owner'
        && request.resource.data.get('isSuperAdmin', false) == false;
      allow update, delete: if false;
    }

    // Contador de numeração sequencial por empresa (ex.: nextOrderNumber
    // pra pedidos). Qualquer membro da empresa pode ler/escrever — não é
    // restrito a owner/admin como companies/{id}, porque criar um pedido
    // é uma ação operacional comum, não administrativa.
    match /counters/{companyId} {
      allow read, write: if isSignedIn() && userCompanyId() == companyId;
    }

    match /companies/{companyId} {
      allow read: if isSignedIn() && (userCompanyId() == companyId || isSuperAdminUser());
      allow create: if isSignedIn() && (
        companyId == request.auth.uid ||
        (userCompanyId() == companyId && userRole() in ['owner', 'admin'])
      );
      allow update, delete: if isSignedIn()
        && userCompanyId() == companyId
        && userRole() in ['owner', 'admin'];
    }

    match /{collection}/{docId} {
      allow read: if isSignedIn()
        && isOperationalCollection(collection)
        && (resource.data.companyId == userCompanyId() || isSuperAdminUser());

      allow create: if isSignedIn()
        && isOperationalCollection(collection)
        && (request.resource.data.companyId == userCompanyId() || isSuperAdminUser());

      allow update: if isSignedIn()
        && isOperationalCollection(collection)
        && (resource.data.companyId == userCompanyId() || isSuperAdminUser())
        && request.resource.data.companyId == resource.data.companyId;

      allow delete: if isSignedIn()
        && isOperationalCollection(collection)
        && (resource.data.companyId == userCompanyId() || isSuperAdminUser());
    }
  }
}
