rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function callerUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userCompanyId() {
      return callerUser().companyId;
    }

    function userRole() {
      return callerUser().role;
    }

    function isSuperAdminUser() {
      return callerUser().get('isSuperAdmin', false) == true;
    }

    function isOperationalCollection(collection) {
      return collection in ['products', 'sales', 'comandas', 'orders', 'bills', 'customers', 'purchases', 'purchaseProducts', 'vendedores', 'expenses', 'expenseCategories', 'expenseSeries', 'recurringOrders'];
    }

    // Id da cobranca = companyId + '_' + competence sem hifen (ex.: abc123_202611).
    function competenciaSemHifen(competence) {
      return competence.split('-')[0] + competence.split('-')[1];
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdminUser());
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.companyId == uid
        && request.resource.data.role == 'owner'
        && request.resource.data.get('isSuperAdmin', false) == false;
      allow update, delete: if false;
    }

    // Contador de numeração sequencial por empresa (ex.: nextOrderNumber
    // pra pedidos). Qualquer membro da empresa pode ler/escrever — não é
    // restrito a owner/admin como companies/{id}, porque criar um pedido
    // é uma ação operacional comum, não administrativa.
    match /counters/{companyId} {
      allow read, write: if isSignedIn() && userCompanyId() == companyId;
    }

    match /companies/{companyId} {
      allow read: if isSignedIn() && (userCompanyId() == companyId || isSuperAdminUser());
      allow create: if isSignedIn() && (
        companyId == request.auth.uid ||
        (userCompanyId() == companyId && userRole() in ['owner', 'admin'])
      );
      allow update: if isSignedIn()
        && (
          (userCompanyId() == companyId && userRole() in ['owner', 'admin'])
          || isSuperAdminUser()
        );
      allow delete: if isSignedIn()
        && userCompanyId() == companyId
        && userRole() in ['owner', 'admin'];
    }

    // Mensalidade da plataforma (regra 14). Fora de isOperationalCollection e do
    // bypass generico: so o super-admin escreve; empresa le apenas a propria cobranca.
    match /subscriptions/{companyId} {
      allow read: if isSignedIn() && isSuperAdminUser();
      allow create, update: if isSignedIn()
        && isSuperAdminUser()
        && request.resource.data.companyId == companyId;
      allow delete: if false;
    }

    match /subscriptionCharges/{chargeId} {
      allow read: if isSignedIn()
        && (isSuperAdminUser() || resource.data.companyId == userCompanyId());

      allow create: if isSignedIn()
        && isSuperAdminUser()
        && request.resource.data.status == 'a_pagar'
        && request.resource.data.paidDate == null
        && request.resource.data.paidAmount == null
        && request.resource.data.competence.matches('[0-9]{4}-[0-9]{2}')
        && chargeId == request.resource.data.companyId + '_' + competenciaSemHifen(request.resource.data.competence);

      allow update: if isSignedIn()
        && isSuperAdminUser()
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.competence == resource.data.competence
        && request.resource.data.dueDate == resource.data.dueDate
        && request.resource.data.amount == resource.data.amount
        && (
          (resource.data.status == 'a_pagar'
            && request.resource.data.status == 'pago'
            && request.resource.data.paidDate is string
            && request.resource.data.paidDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.paidAmount == resource.data.amount)
          ||
          (resource.data.status == 'pago'
            && request.resource.data.status == 'a_pagar'
            && request.resource.data.paidDate == null
            && request.resource.data.paidAmount == null)
        );

      allow delete: if false;
    }

    match /{collection}/{docId} {
      allow read: if isSignedIn()
        && isOperationalCollection(collection)
        && (resource.data.companyId == userCompanyId() || isSuperAdminUser());

      allow create: if isSignedIn()
        && isOperationalCollection(collection)
        && (request.resource.data.companyId == userCompanyId() || isSuperAdminUser());

      allow update: if isSignedIn()
        && isOperationalCollection(collection)
        && (resource.data.companyId == userCompanyId() || isSuperAdminUser())
        && request.resource.data.companyId == resource.data.companyId;

      allow delete: if isSignedIn()
        && isOperationalCollection(collection)
        && (resource.data.companyId == userCompanyId() || isSuperAdminUser());
    }
  }
}
