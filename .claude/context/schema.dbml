// Schema — ERP Gaspareto
// Gerado a partir das interfaces em src/models/*.ts e das coleções Firestore
// referenciadas nos services (collection(this.firestore, '<nome>')).
//
// IMPORTANTE: o banco real é Firestore (NoSQL, documentos), não relacional.
// Este DBML é uma representação aproximada para visualização/documentação —
// não existem chaves estrangeiras de fato nem integridade referencial no
// banco; os relacionamentos abaixo (Ref:) são inferidos de campos que guardam
// o id de outro documento (ex.: idProduct, customerId) e são reforçados só
// pela lógica das transações no código-cliente, não pelo Firestore.

Table companies {
  id            string    [pk, note: 'doc id gerado pelo Firestore']
  name          string
  document      string    [null]
  plan          string    [note: 'trial | basic | pro']
  status        string    [note: 'active | suspended | canceled']
  modules       json      [note: 'ModuleConfig: pdv, pedidos, gestao, rotas, contas (rótulo Despesas), clientes, vendedores (booleans) — substitui o doc único config/company. Chave legada compras é ignorada']
  createdAt     timestamp
}

Table users {
  uid           string    [pk, note: 'id = uid do Firebase Auth']
  email         string
  companyId     string    [ref: > companies.id]
  role          string    [note: 'owner | admin | employee']
  createdAt     timestamp
}

Table products {
  id            string    [pk, note: 'doc id gerado pelo Firestore']
  companyId     string    [ref: > companies.id, note: 'isolamento multi-tenant, ver regra-de-negocio.md seção 10']
  title         string
  buyPrice      number    [note: 'sobrescrito pela última compra registrada (ver regra-de-negocio.md)']
  sellPrice     number
  stock         number
  urlImage      string    [null, note: 'base64 da imagem, salvo direto no doc']
  color         string    [null]
}

Table customers {
  id            string    [pk]
  companyId     string    [ref: > companies.id, note: 'isolamento multi-tenant, ver regra-de-negocio.md seção 10']
  name          string
  phone         string    [null]
  address       string    [null, note: 'endereço formatado livre, fallback']
  cep           string    [null]
  rua           string    [null]
  numero        string    [null]
  complemento   string    [null]
  bairro        string    [null]
  cidade        string    [null]
  uf            string    [null]
  lat           number    [null]
  lng           number    [null]
}

Table vendedores {
  id            string    [pk, note: 'doc id gerado pelo Firestore']
  companyId     string    [ref: > companies.id, note: 'isolamento multi-tenant, ver regra-de-negocio.md seção 10']
  name          string
  comissoes     json      [note: 'array de VendedorComissaoItem embutido: idProduct, percentual (0-100) — produto do catálogo sem entrada aqui = 0% de comissão']
}

Table sales {
  id             string    [pk]
  companyId      string    [ref: > companies.id, note: 'isolamento multi-tenant, ver regra-de-negocio.md seção 10']
  total          number
  date           timestamp
  items          json      [note: 'array de SaleItem embutido: idProduct, productName, quantity, priceAtSale, priceAtCost']
  paymentMethod  string    [null, note: 'enum: dinheiro | pix | cartao | cheque | boleto | misto. Venda de pedido nasce sem forma (null) e recebe na conclusão; misto = mais de uma forma']
  installments   number    [null, note: 'informativo; Pix = 1']
  sale_type      string    [note: 'pdv | order']
  customerId     string    [null, ref: > customers.id, note: 'só preenchido quando sale_type = order']
  status         string    [note: 'completed | canceled — não está na interface TS, escrito direto pelo service']
}

Table orders {
  id                    string    [pk]
  companyId             string    [ref: > companies.id, note: 'isolamento multi-tenant, ver regra-de-negocio.md seção 10']
  orderNumber           number    [note: 'sequencial por empresa (#1, #2, ...), gerado via counters/{companyId} em transação — só controle humano, não usar como id']
  customerName          string
  customerPhone         string    [null]
  customerId            string    [null, ref: > customers.id]
  vendedorId            string    [null, ref: > vendedores.id, note: 'opcional — pedido pode ser criado/editado/finalizado sem vendedor']
  vendedorName          string    [null, note: 'snapshot do nome do vendedor no momento do vínculo']
  items                 json      [note: 'array de OrderItem embutido: idProduct, productName, quantity, priceAtSale, priceAtCost']
  itemsTotal            number
  shippingCost          number
  total                 number    [note: 'itemsTotal + shippingCost']
  deliveryType          string    [note: 'pickup | delivery']
  address               string    [null]
  addressLat            number    [null]
  addressLng            number    [null]
  status                string    [note: 'open|pending|preparing|ready|delivering|delivered|finished|canceled']
  createdAt             timestamp
  scheduledDate         timestamp
  actualDeliveryDate    timestamp [null]
  paymentDate           timestamp [null]
  closingDate           timestamp [null]
  saleId                string    [null, ref: > sales.id, note: 'Sale criada na entrega (regra 5.3). Ausente em pedido delivered antes do deploy']
  payments              json      [null, note: 'array embutido de OrderPayment: id, amount, method, installments, dueDate?, paidDate?, status (previsto|pago|cancelado|estornado). Ausente = pedido antigo; finished antigo = 1 pagamento derivado']
  paymentMethod         string    [null, note: 'preenchido na conclusão; pode ser misto']
  installments          number    [null]
  observations          string    [null]
  recurringOrderId      string    [null, ref: > recurringOrders.id, note: 'pedido gerado por recorrência (regra 5.4); id do doc = rec_{recurringOrderId}_{yyyyMMdd}']
  occurrenceDate        string    [null, note: 'yyyy-MM-dd da ocorrência']
}

Table recurringOrders {
  id                string    [pk]
  companyId         string    [ref: > companies.id, note: 'isolamento multi-tenant, regra 10']
  sourceOrderId     string    [null, ref: > orders.id]
  status            string    [note: 'active | paused | ended']
  frequency         string    [note: 'weekly | biweekly | monthly | weekdays']
  weekdays          json      [null, note: 'number[] 0..6, só em frequency=weekdays']
  startDate         string    [note: 'yyyy-MM-dd civil']
  endDate           string    [null, note: 'yyyy-MM-dd inclusivo']
  generateFrom      string    [note: 'limite inferior de geração; retomar = hoje']
  lastGeneratedDate string    [null, note: 'cursor, gravado na mesma transação do pedido gerado']
  generatedCount    number    [null]
  lastIssue         json      [null, note: '{date, code, detail} ocorrência pulada']
  customerId        string    [ref: > customers.id]
  customerName      string
  customerPhone     string    [null]
  items             json      [note: 'idProduct, productName, quantity, soldByWeight? — SEM preço']
  shippingCost      number
  deliveryType      string    [note: 'pickup | delivery']
  address           string    [null]
  addressLat        number    [null]
  addressLng        number    [null]
  observations      string    [null]
  vendedorId        string    [null, ref: > vendedores.id]
  vendedorName      string    [null]
  createdAt         timestamp
}

Table comandas {
  id            string    [pk]
  companyId     string    [ref: > companies.id, note: 'isolamento multi-tenant, ver regra-de-negocio.md seção 10']
  customerName  string
  items         json      [note: 'array de ComandaItem embutido: idProduct, productName, quantity, priceAtSale, priceAtCost']
  total         number
  createdAt     timestamp
  status        string    [note: 'open | closed']
}

Table purchases {
  id            string    [pk]
  companyId     string    [ref: > companies.id, note: 'isolamento multi-tenant, ver regra-de-negocio.md seção 10']
  date          timestamp
  idProduct     string    [ref: > products.id]
  unityValue    number
  amount        number
}

Table purchaseProducts {  // LEGADO — substituído por expenseSeries (regra-de-negocio.md §7.3/§14); mantido até purga
  id                string    [pk]
  companyId         string    [ref: > companies.id, note: 'isolamento multi-tenant, ver regra-de-negocio.md seção 10']
  name              string
  defaultValue      number
  recurring         boolean
  recurrencePeriod  string    [null, note: 'weekly | monthly (inglês, diferente de bills)']
  createdAt         timestamp
}

Table bills {  // LEGADO — substituído por expenses (regra-de-negocio.md §7/§14); mantido até purga
  id                  string    [pk]
  companyId           string    [ref: > companies.id, note: 'isolamento multi-tenant, ver regra-de-negocio.md seção 10']
  name                string
  value               number
  dueDate             timestamp [null]
  status              string    [note: 'pendente | recebido | pago']
  recurring           boolean
  recurrencePeriod    string    [null, note: 'semanal | mensal (português, diferente de purchaseProducts)']
  paidAt              timestamp [null]
  receivedAt          timestamp [null]
  createdAt           timestamp
  purchaseProductId   string    [null, ref: > purchaseProducts.id]
}

Table config {
  id       string  [pk, note: "único doc usado: id = 'company' — LEGADO"]
  modules  json    [note: 'ModuleConfig — substituído por companies.modules (ver regra-de-negocio.md seção 11); manter documentado até confirmar remoção do doc config/company em produção']
}

Table counters {
  id               string  [pk, note: 'doc id = companyId — um contador por empresa']
  nextOrderNumber  number  [note: 'próximo orderNumber a emitir (começa em 1 se doc não existe); lido e incrementado via runTransaction em OrderService.addOrder, garante sequência atômica mesmo com escritas concorrentes']
}

// Observações:
// - items dentro de sales/orders/comandas são arrays embutidos no próprio
//   documento (subcoleção não é usada) — cada item referencia products.id
//   via idProduct, mas sem enforcement do banco.
// - company_id é campo simples (não FK real do Firestore) — a integridade é
//   reforçada só por firestore.rules e pelo código-cliente (TenantService),
//   nunca pelo banco em si. Ver regra-de-negocio.md seção 10 para o motivo de
//   ser campo e não subcoleção companies/{id}/products/...
// - purchaseProducts: nome real da coleção no código (PurchaseProductService.COL).

Table expenseCategories {
  id            string    [pk, note: 'padrão: ${companyId}_${systemKey} (determinístico); custom: id do Firestore']
  companyId     string    [ref: > companies.id, note: 'isolamento multi-tenant, ver regra-de-negocio.md seção 10']
  name          string
  type          string    [note: 'custo_producao | despesa_operacional — imutável após criar; custo_producao não entra no Resultado (§8)']
  archived      boolean   [note: 'categoria com despesa vinculada só arquiva, nunca exclui']
  systemKey     string    [null, note: 'só nas 12 padrão: compra_mercadoria, insumos_embalagem, aluguel, energia_agua_gas, internet_telefone, transporte_combustivel, pessoal, impostos_taxas, taxas_cartao, marketing, manutencao_equipamentos, outros']
  createdAt     timestamp
}

Table expenseSeries {
  id                    string    [pk, note: 'migradas: mig_pp_<purchaseProductId>']
  companyId             string    [ref: > companies.id, note: 'isolamento multi-tenant, ver regra-de-negocio.md seção 10']
  active                boolean   [note: 'false = série encerrada; ocorrências já geradas ficam']
  period                string    [note: 'semanal | mensal']
  anchorDate            string    [note: 'YYYY-MM-DD; ocorrência k = âncora + k períodos (mensal calculado da âncora, clamp de dia)']
  generatedThrough      string    [null, note: 'YYYY-MM-DD da última ocorrência materializada (marca-d''água; evita ressuscitar ocorrência apagada)']
  template              json      [note: 'description, value, categoryId, supplier?, paymentMethod?, notes?']
  legacyPurchaseProductId string  [null]
  migracaoRevisar       boolean   [null]
  createdAt             timestamp
  endedAt               timestamp [null]
}

Table expenses {
  id                  string    [pk, note: 'ocorrência de série: ${seriesId}_${dueDate}; migrada: mig_bill_<billId>; demais: id do Firestore']
  companyId           string    [ref: > companies.id, note: 'isolamento multi-tenant, ver regra-de-negocio.md seção 10']
  description         string
  value               number    [note: 'reais, 2 casas; parcelas calculadas em centavos, resto na última']
  categoryId          string    [ref: > expenseCategories.id]
  dueDate             string    [note: 'YYYY-MM-DD, OBRIGATÓRIO; critério de competência (Resultado) e de vencida']
  status              string    [note: 'a_pagar | pago. Vencida é DERIVADA (a_pagar e dueDate < hoje), não gravada']
  paidDate            string    [null, note: 'YYYY-MM-DD; visão de caixa (Pago no mês)']
  paymentMethod       string    [null, note: 'enum PaymentMethod: dinheiro | pix | cartao | cheque']
  supplier            string    [null, note: 'texto livre']
  notes               string    [null]
  goodsReceivedDate   string    [null, note: 'YYYY-MM-DD; substitui o antigo status recebido']
  origin              string    [note: 'manual | parcelamento | recorrencia | migracao']
  seriesId            string    [null, ref: > expenseSeries.id]
  installmentGroupId  string    [null]
  installmentNumber   number    [null]
  installmentTotal    number    [null]
  legacyBillId        string    [null]
  migracaoRevisar     boolean   [null, note: 'filtrável na tela; vencimento por fallback ou categoria sem casamento']
  migracaoMotivo      string    [null]
  createdAt           timestamp
}
